# Cloudflare Pages headers
# Static assets cache long; HTML stays fresh. API responses set their own
# Cache-Control in-function, so they are not listed here.

/*.png
  Cache-Control: public, max-age=86400

/*.svg
  Cache-Control: public, max-age=86400

/*.ico
  Cache-Control: public, max-age=86400

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/wc2026.html
  Cache-Control: public, max-age=0, must-revalidate
